#!/usr/bin/env python3
"""假的生图接口：测试时代替 OpenAI 的生图接口（见 AIImageTests.swift）。

用法：fake-image-api <目录>。在 127.0.0.1 的随机端口上监听，第一行往 stdout 写端口号。
每个请求在 <目录>/requests/<序号>.json 里记下路径、带没带密钥（只记是不是测试给的那个，不记原文）与请求体。
怎么回答看 <目录>/mode.json（没有时照常出图）：
  {"status": 401, "message": "…"}   回错误，body 是 {"error": {"message": …}}
  {"hang": true}                    一直不回，等客户端断开或 <目录>/release 出现
照常出图时回 n 张，{"data": [{"b64_json": …}]}。
图是 64 × 96 的纯色 PNG，每张颜色不同。
"""
import base64
import json
import os
import struct
import sys
import threading
import time
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = sys.argv[1]
TEST_KEY = "sk-test-mediacraft"
os.makedirs(os.path.join(HERE, "requests"), exist_ok=True)
counter = {"requests": 0, "images": 0}
lock = threading.Lock()


def png(width, height, rgb):
    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    row = b"\x00" + bytes(rgb) * width
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(row * height)) + chunk(b"IEND", b""))


def next_image():
    with lock:
        counter["images"] += 1
        index = counter["images"]
    rgb = [(40 * index) % 256, (90 + 50 * index) % 256, (200 - 30 * index) % 256]
    return base64.b64encode(png(64, 96, rgb)).decode()


def mode():
    try:
        with open(os.path.join(HERE, "mode.json"), encoding="utf-8") as handle:
            return json.load(handle)
    except OSError:
        return {}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(length) or b"{}")
        auth = self.headers.get("Authorization") or ""
        with lock:
            counter["requests"] += 1
            index = counter["requests"]
        record = {
            "path": self.path,
            "bearerKey": auth == f"Bearer {TEST_KEY}",
            "body": body,
        }
        with open(os.path.join(HERE, "requests", f"{index}.json"), "w", encoding="utf-8") as handle:
            json.dump(record, handle, ensure_ascii=False)
        behaviour = mode()
        if behaviour.get("hang"):
            deadline = time.time() + 60
            while time.time() < deadline and not os.path.exists(os.path.join(HERE, "release")):
                time.sleep(0.05)
        if behaviour.get("status", 200) != 200:
            self.reply(behaviour["status"], {"error": {"message": behaviour.get("message", "出错了")}})
        else:
            self.reply(200, {"data": [{"b64_json": next_image()} for _ in range(int(body.get("n", 1)))]})


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
server.daemon_threads = True
sys.stdout.write(f"{server.server_address[1]}\n")
sys.stdout.flush()
server.serve_forever()
