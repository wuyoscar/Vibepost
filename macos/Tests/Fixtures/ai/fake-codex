#!/usr/bin/env python3
"""假的 codex：测试时代替本机 Codex CLI（见 AICodexTests.swift）。

测试把它复制进一个临时目录（名字就叫 codex），同目录里放回放脚本：
  script-<第几次调用>.jsonl，没有时用 script.jsonl。
  `codex --version`：打印版本；`codex login status`：同目录里有 logged-out 这个文件时报没登录（退出码 1），否则已登录。
  `codex app-server`：在 stdio 上说 JSON-RPC（每行一条），像真的 app-server：
    initialize → 回答；initialized（通知）不回答；model/list → 两个假模型（各带能选的推理强度；只问模型的进程不记调用）；
    thread/start → 新建一个线程（UUID），回答 { thread: { id }, model }，发 thread/started 通知；
    thread/resume → 同目录 threads/ 里有这个线程才回答，没有就报错（像线程在 Codex 那边没了）；
      同目录有 resume-error 文件时，照它的内容报别的错（线程还在，只是这次续不上）；
    turn/start → 回答 { turn: { id, status: "inProgress" } }，发 turn/started，然后回放脚本；
    turn/interrupt → 发 turn/completed（status: interrupted）；
  读到 EOF（App 关上 stdin）才退出。
开线程或续线程的进程算一次调用（序号从 1 起），在 calls/<序号>.json 里记下参数、工作目录、进程号、开始时的 draft.md / title.txt / caption.txt、
stdin 收到的每一行、页面对服务端请求的回答（responses，按请求 id）、收到的信号，以及 stdin 有没有被关上。

脚本一行一个要发的 JSON（通知，原样发出；{{THREAD}}、{{TURN}}、{{CWD}} 换成线程 id、这一轮的 id、工作目录）；
以 # 开头的是动作：
  #sleep 秒数
  #write ["文件", "内容"]          在工作目录里写文件（像它自己改文件）
  #request {"id": …, "method": …, "params": {…}}   发一个服务端请求（审批、动态工具调用……），等到它的回答再往下走
  #hang                            一直不结束，等着被停止
  #ignore-sigint                   忽略 SIGINT
  #stderr "文字"                   往 stderr 写一行
  #exit 退出码                     马上退出
脚本回放完如果还没发过 turn/completed，就补一条 status: completed。
"""
import json
import os
import signal
import sys
import threading
import time
import uuid

HERE = os.path.dirname(os.path.abspath(sys.argv[0]))
ARGS = sys.argv[1:]

if "--version" in ARGS:
    print("codex-cli 9.9.9")
    sys.exit(0)
if ARGS[:2] == ["login", "status"]:
    if os.path.exists(os.path.join(HERE, "logged-out")):
        print("Not logged in")
        sys.exit(1)
    print("Logged in using ChatGPT")
    sys.exit(0)
if ARGS[:1] != ["app-server"]:
    print(f"fake codex: 不认识的用法 {ARGS}", file=sys.stderr)
    sys.exit(2)


def read_file(name):
    try:
        with open(name, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return None


calls = os.path.join(HERE, "calls")
threads = os.path.join(HERE, "threads")
os.makedirs(calls, exist_ok=True)
os.makedirs(threads, exist_ok=True)
index = None  # 收到开线程或续线程时才登记这次调用（begin）

record = {
    "argv": ARGS,
    "cwd": os.getcwd(),
    "pid": os.getpid(),
    "draft": read_file("draft.md"),
    "title": read_file("title.txt"),
    "caption": read_file("caption.txt"),
    "stdin": [],
    "responses": {},
    "signals": [],
    "stdinClosed": False,
}
lock = threading.Lock()
answered = threading.Condition(lock)
state = {"thread": None, "turn": None, "completed": False, "interrupted": False}


def begin():
    global index, SCRIPT
    if index is not None:
        return
    candidate = 1
    while True:
        try:
            descriptor = os.open(os.path.join(calls, f"{candidate}.json"), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(descriptor)
            break
        except FileExistsError:
            candidate += 1
    index = candidate
    script_path = os.path.join(HERE, f"script-{index}.jsonl")
    if not os.path.exists(script_path):
        script_path = os.path.join(HERE, "script.jsonl")
    with open(script_path, encoding="utf-8") as handle:
        SCRIPT = [line.rstrip("\n") for line in handle if line.strip()]
    if "#ignore-sigint" in SCRIPT:
        state["ignore-sigint"] = True


def save():
    if index is None:
        return
    with open(os.path.join(calls, f"{index}.json"), "w", encoding="utf-8") as handle:
        json.dump(record, handle, ensure_ascii=False)


def send(obj):
    with lock:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()


def on_signal(number, _frame):
    with lock:
        record["signals"].append(number)
        save()
    if number == signal.SIGINT and "ignore-sigint" in state:
        return
    sys.exit(128 + number)


signal.signal(signal.SIGINT, on_signal)
signal.signal(signal.SIGTERM, on_signal)

SCRIPT = []


def fill(text):
    return (text.replace("{{THREAD}}", state["thread"] or "")
            .replace("{{TURN}}", state["turn"] or "")
            .replace("{{CWD}}", os.getcwd()))


def complete(status="completed"):
    if state["completed"]:
        return
    state["completed"] = True
    send({"method": "turn/completed", "params": {"threadId": state["thread"], "turn": {
        "id": state["turn"], "items": [], "status": status, "error": None,
        "startedAt": 1790000000, "completedAt": 1790000003, "durationMs": 3000}}})


def replay():
    for line in SCRIPT:
        if state["completed"]:
            return
        if line.startswith("#"):
            action, _, rest = line[1:].partition(" ")
            if action == "sleep":
                time.sleep(float(rest))
            elif action == "write":
                name, content = json.loads(rest)
                with open(name, "w", encoding="utf-8") as handle:
                    handle.write(content)
            elif action == "request":
                request = json.loads(fill(rest))
                send(request)
                with answered:
                    while str(request["id"]) not in record["responses"] and not record["stdinClosed"]:
                        answered.wait(0.1)
            elif action == "hang":
                while not record["stdinClosed"]:
                    time.sleep(0.1)
                return
            elif action == "stderr":
                print(json.loads(rest), file=sys.stderr, flush=True)
            elif action == "exit":
                with lock:
                    save()
                os._exit(int(rest))
            continue
        obj = json.loads(fill(line))
        send(obj)
        # 这个线程的 turn/completed 才算说完（脚本里也可以放子线程的）
        if obj.get("method") == "turn/completed" and (obj.get("params") or {}).get("threadId") in (None, state["thread"]):
            state["completed"] = True
    complete()


def respond(request_id, result=None, error=None):
    send({"id": request_id, **({"error": error} if error else {"result": result})})


for raw in sys.stdin:
    line = raw.rstrip("\n")
    if not line:
        continue
    with lock:
        record["stdin"].append(line)
        save()
    try:
        message = json.loads(line)
    except json.JSONDecodeError:
        continue
    method = message.get("method")
    if method is None and "id" in message:
        # 页面对服务端请求的回答
        with answered:
            record["responses"][str(message["id"])] = message.get("result", {"error": message.get("error")})
            save()
            answered.notify_all()
        continue
    if method == "initialize":
        respond(message["id"], {"userAgent": "fake-codex/9.9.9"})
    elif method == "model/list":
        def efforts(*names):
            return [{"reasoningEffort": name, "description": name} for name in names]
        respond(message["id"], {"data": [
            {"id": "gpt-fake-large", "displayName": "GPT Fake Large", "isDefault": True,
             "supportedReasoningEfforts": efforts("low", "medium", "high", "xhigh", "max", "ultra"), "defaultReasoningEffort": "low"},
            {"id": "gpt-fake-mini", "displayName": "GPT Fake Mini", "isDefault": False,
             "supportedReasoningEfforts": efforts("low", "high"), "defaultReasoningEffort": "high"},
        ]})
    elif method == "thread/start":
        begin()
        with lock:
            save()
        state["thread"] = str(uuid.uuid4())
        open(os.path.join(threads, state["thread"]), "w").close()
        respond(message["id"], {"thread": {"id": state["thread"]}, "model": message["params"].get("model") or "gpt-fake"})
        send({"method": "thread/started", "params": {"thread": {"id": state["thread"]}}})
    elif method == "thread/resume":
        begin()
        with lock:
            save()
        thread = message["params"].get("threadId")
        resume_error = read_file(os.path.join(HERE, "resume-error"))
        if resume_error:
            respond(message["id"], error={"code": -32603, "message": resume_error})
            continue
        if not os.path.exists(os.path.join(threads, str(thread))):
            respond(message["id"], error={"code": -32600, "message": f"no rollout found for thread id {thread}"})
            continue
        state["thread"] = thread
        respond(message["id"], {"thread": {"id": thread}, "model": message["params"].get("model") or "gpt-fake"})
    elif method == "turn/start":
        state["turn"] = str(uuid.uuid4())
        respond(message["id"], {"turn": {"id": state["turn"], "status": "inProgress", "items": []}})
        send({"method": "turn/started", "params": {"threadId": state["thread"], "turn": {"id": state["turn"]}}})
        threading.Thread(target=replay, daemon=True).start()
    elif method == "turn/interrupt":
        respond(message["id"], {})
        complete("interrupted")
    elif "id" in message:
        respond(message["id"], error={"code": -32601, "message": f"fake codex 不支持 {method}"})

with lock:
    record["stdinClosed"] = True
    save()
