      }
    },
    {
      "category": "traffic",
      "level": "warn",
      "reason": "小红书社区规范：不能在笔记里留电话、QQ 号这类联系方式",
      "name": "手机号",
      "pattern": "(?<!\\d)1[3-9]\\d(?:[- ]?\\d{4}){2}(?!\\d)",
      "suggest": ""
    },
    {
      "category": "traffic",
      "level": "warn",
      "reason": "小红书社区规范：不能在笔记里留电话、QQ 号这类联系方式",
      "name": "座机号",
      "pattern": "(?<!\\d)0\\d{2,3}-\\d{7,8}(?!\\d)",
      "suggest": ""
    },
    {
      "category": "traffic",
      "level": "warn",
      "reason": "小红书社区规范：不能在笔记里留电话、QQ 号这类联系方式",
      "name": "QQ 号",
      "pattern": "(?:QQ|扣扣)\\s*(?:号|群)?\\s*[:：]?\\s*\\d{5,11}(?!\\d)",
      "suggest": ""
    },
    {
      "category": "traffic",
      "level": "warn",
      "reason": "笔记里的网址点不开，还会被当作站外导流",
      "name": "网址",
      "pattern": "(?:https?://|www\\.)[^\\s，。！？、；：“”‘’（）()<>「」]+",
      "suggest": ""
    },
    {
      "category": "traffic",
      "level": "hint",
      "reason": "留邮箱也算站外联系方式",
      "name": "邮箱",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}",
      "suggest": ""
    },
    {
      "category": "traffic",
      "level": "hint",
      "reason": "提到别的平台或让人私聊，容易被判导流；只是随口一提可以忽略",
      "words": {
