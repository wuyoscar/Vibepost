{
  "about": "发布检查的词库：MediaCraft 自己按公开的法规与平台规范整理，来源与规则见 docs/publish-check.md。words 是「词 → 建议改成的字」（空字符串 = 建议删掉，null = 没有通用的改法）；pattern 是正则（不分大小写）。level：warn 警告、hint 提示。",
  "version": 1,
  "categories": [
    { "id": "absolute", "label": "极限词" },
    { "id": "medical", "label": "医疗用语" },
    { "id": "finance", "label": "收益承诺" },
    { "id": "traffic", "label": "引流" }
  ],
  "rules": [
    {
      "category": "absolute",
      "level": "warn",
      "reason": "广告法第九条：不得使用「国家级」「最高级」「最佳」等绝对化用语",
      "words": {
        "国家级": "",
        "世界级": "",
        "最高级": "",
        "最佳": "很好",
        "最优": "优秀",
        "最强": "很强",
        "最先进": "先进",
        "最顶级": "",
        "顶级": "高端",
        "顶尖": "出色",
        "最权威": "",
        "最正宗": "正宗",
        "最专业": "专业",
        "最安全": "安全",
        "最有效": "有效",
        "最科学": "科学",
        "史上最": "",
        "全网最": "",
        "全国最": "",
        "全球最": "",
        "世界第一": "",
        "全国第一": "",
        "全网第一": "",
        "销量第一": "",
        "排名第一": "",
        "行业第一": "",
        "NO.1": "",
        "TOP1": "",
        "独一无二": "",
        "绝无仅有": "",
        "空前绝后": "",
        "无与伦比": "",
        "万能": "多用"
      }
    },
    {
      "category": "absolute",
      "level": "warn",
      "reason": "广告法第九条：价格上的「最低」「最便宜」也是绝对化用语",
      "words": {
        "最低价": "低价",
        "最便宜": "实惠",
        "全网最低": "",
        "史上最低": ""
      }
    },
    {
      "category": "absolute",
      "level": "hint",
      "reason": "常被当作绝对化用语；只是日常说法（比如「最好先洗脸」「唯一的遗憾」）可以忽略",
      "words": {
        "最好": "很好",
        "最火": "很火",
        "最全": "很全",
        "最受欢迎": "很受欢迎",
        "唯一": null,
        "首选": "推荐",
        "绝对": "非常",
        "永久": "长期",
        "完美": null,
        "极致": null
      }
    },
    {
      "category": "absolute",
      "level": "hint",
      "reason": "「第一」讲排名时算绝对化用语；讲顺序（第一次、第一步）不算，已自动跳过",
      "name": "第一",
      "pattern": "第一(?![次步天眼时个章节页张篇段条点句回场集期季轮届年月周部本件位层种类批号份遍趟阶人印感反])",
      "suggest": null
    },
    {
      "category": "medical",
      "level": "warn",
      "reason": "广告法第十七条：药品、医疗器械以外不得涉及疾病治疗功能、不得用医疗用语；第十六条：不得断言功效与安全性",
      "words": {
        "治愈": "",
        "根治": "",
        "药到病除": "",
        "包治百病": "",
        "永不复发": "",
        "一次见效": "",
        "无副作用": "",
        "零副作用": "",
        "无毒副作用": "",
        "抗癌": "",
        "防癌": "",
        "治癌": "",
        "降血压": "",
        "降血糖": "",
        "降血脂": "",
        "医用级": "",
        "疗效": "效果"
      }
    },
    {
      "category": "medical",
      "level": "warn",
      "reason": "广告法第十六条：不得说明治愈率、有效率，不得保证功效",
      "name": "百分之百有效",
      "pattern": "(?:100\\s*%|百分之百|百分百)(?:有效|见效|治愈|安全|无害)",
      "suggest": ""
    },
    {
      "category": "medical",
      "level": "hint",
      "reason": "容易被当成医疗用语；只是讲自己的就医经历可以忽略",
      "words": {
        "治疗": null,
        "消炎": null,
        "杀菌": null,
        "祛斑": null,
        "药用": null,
        "立竿见影": "很快见效"
      }
    },
    {
      "category": "finance",
      "level": "warn",
      "reason": "广告法第二十五条：有投资回报预期的内容不得保证收益，不得明示或暗示保本、无风险、保收益",
      "words": {
        "保本": "",
        "保收益": "",
        "保证收益": "",
        "稳赚": "",
        "稳赚不赔": "",
        "只赚不赔": "",
        "包赚": "",
        "躺赚": "",
        "零风险": "",
        "无风险": ""
      }
    },
    {
      "category": "finance",
      "level": "hint",
      "reason": "收益说法容易被判夸大，写清楚条件与风险",
      "words": {
        "高回报": null,
        "稳定收益": null,
        "暴富": null
      }
    },
    {
      "category": "finance",
      "level": "hint",
      "reason": "收益说法容易被判夸大，写清楚条件与风险",
      "name": "日入过万",
      "pattern": "(?:日|月)入(?:过|上)?[千万]",
      "suggest": null
    },
    {
      "category": "traffic",
      "level": "warn",
      "reason": "小红书社区规范：不能在笔记里留站外联系方式、引导去别的平台",
      "words": {
        "加微信": "",
        "微信号": "",
        "薇信": "",
        "威信": "",
        "V信": "",
        "加V": "",
        "加薇": "",
